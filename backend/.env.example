# SPIT Hostel Management System - Environment Variables Template
# Copy this file to .env and configure for your deployment environment

# ─── SERVER CONFIGURATION ───
PORT=5000
NODE_ENV=development

# ─── DATABASE CONFIGURATION ───
# For local development:
MONGODB_URI=mongodb://localhost:27017/hostel_db
# For production (e.g., MongoDB Atlas / College intranet cluster):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hostel_db?retryWrites=true&w=majority

# ─── AUTHENTICATION & SECURITY ───
JWT_SECRET=spit_hostel_super_secure_jwt_secret_key_2025
JWT_EXPIRES_IN=7d

# ─── SMS GATEWAY CONFIGURATION (SPIT HANDOVER / PRODUCTION) ───
# By default, the system runs in ZERO-COST HANDOVER SIMULATION MODE without any keys.
# When handing over to SPIT College IT administration, insert your institutional DLT credentials below:

# Option 1: MSG91 Enterprise Gateway (Recommended for Indian Universities with TRAI DLT Header)
# MSG91_AUTH_KEY=your_msg91_authkey_here
# MSG91_SENDER_ID=SPITHS
# MSG91_TEMPLATE_ID=your_dlt_approved_template_id_here

# Option 2: Fast2SMS Quick Gateway (Alternative for testing)
# FAST2SMS_API_KEY=your_fast2sms_api_key_here
